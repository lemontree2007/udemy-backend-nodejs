    <div class="wrapper-form">
      <fieldset>
        <legend>Delete Users</legend>
        <form action="/delete-user" method="post">
          <div class="d-none">
            <label for="fname">id</label>
            <input type="text" name="userId" value="<%= userEdit.id %>" />
          </div>
